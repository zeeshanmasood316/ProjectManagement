{
  "name": "ai-project-management-assistant",
  "version": "2.8.0",
  "description": "Deployment-ready enterprise workspace with organization management, member presence, profiles, notifications, account security, accessible responsive UX, and AI project delivery tools.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "reset": "node scripts/reset.js",
    "seed": "node scripts/reset.js",
    "seed:demo": "node scripts/seed-demo.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "start:prod": "NODE_ENV=production node src/server.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "busboy": "^1.6.0",
    "mammoth": "^1.12.1",
    "nodemailer": "^7.0.5",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
