# Application
NODE_ENV=development
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=data/project_assistant_js.db

# Security
# Required in production. Use a randomly generated secret with 32+ characters.
TOKEN_SECRET=replace-with-a-long-random-production-secret
TOKEN_TTL_HOURS=24
SECURE_COOKIES=false
TRUST_PROXY=false
REQUEST_TIMEOUT_MS=30000
REQUEST_BODY_LIMIT_BYTES=1000000
AUTH_RATE_LIMIT_PER_15_MINUTES=60
API_RATE_LIMIT_PER_MINUTE=300

# AI provider (Gemini is the easiest default; the API key stays server-side)
ALLOW_EXTERNAL_AI=true
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Verify the exact current model id in Google AI Studio before setting this —
# do not guess a model name here.
AI_MODEL=
AI_PROVIDER_URL=
AI_PROVIDER_API_KEY=
AI_REQUEST_TIMEOUT_MS=45000

# Optional Groq / OpenAI-compatible alternative:
# AI_PROVIDER=groq
# AI_PROVIDER_URL=https://api.groq.com/openai/v1
# AI_PROVIDER_API_KEY=your-key
# AI_MODEL=your-supported-model-id

# Persistent FULL workspace database (required for durable data on Render Free)
# Create a Turso libSQL database (not local SQLite) and add its URL + auth token here.
# When both values are set, ALL app data uses Turso: users, sessions, orgs, projects, tasks, chat, AI plans, reports, settings, etc.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-database-token

# Password reset email (SMTP)
# Example for Gmail: smtp.gmail.com / 587 / false, with a Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
PASSWORD_RESET_CODE_TTL_MINUTES=15
